{
  "manifest_version": 3,
  "name": "Transcriber",
  "version": "1.1.0",
  "description": "Simple Google Meet transcripts. Private and open source. Created by Byte by Byte.",
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup/index.html"
  },
  "side_panel": {
    "default_path": "side-panel/index.html"
  },
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8080/*",
    "http://localhost:8080/*"
  ],
  "optional_permissions": [
    "notifications"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["icon.png"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background-script/index.js",
    "type": "module"
  }
}
